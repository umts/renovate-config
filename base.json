{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["bundler", "ruby-version"],
      "addLabels": ["ruby"]
    },
    {
      "matchManagers": ["npm", "nodenv"],
      "addLabels": ["javascript"]
    },
    {
      "matchManagers": ["ruby-version", "nodenv"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDepNames": ["rails"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "datatables.net",
      "matchPackageNames": ["datatables.net*"]
    },
    {
      "groupName": "fullcalendar",
      "matchPackageNames": ["@fullcalendar/*", "fullcalendar"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom"]
    },
    {
      "groupName": "stylelint",
      "matchPackageNames": ["stylelint*"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["@vitejs/*", "vite"]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["@vitest/*", "@testing-library/*", "vitest*"]
    }
  ]
}
